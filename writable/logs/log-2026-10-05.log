    }

    .config-badge-rigid { background: #dbeafe; color: #1e40af; }
    .config-badge-tractor { background: #fef3c7; color: #92400e; }
    .config-badge-trailer { background: #d1fae5; color: #065f46; }

    .dataTables_wrapper {
        font-family: \'Inter\', sans-serif;
    }

    .dataTables_filter {
