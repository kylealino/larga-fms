            <i class="bi bi-plus-circle"></i> New Tool
        </button>
    </div>
</div>

<!-- ============================================ -->
<!-- STATS -->
<!-- ============================================ -->
<div class="stat-grid">
    <div class="stat-card active" data-filter="all" onclick="filterToolTable(\'all\')">
