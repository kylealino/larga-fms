    /* ============================================ */
    .truck-image-sm {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid var(--gray-200);
        background: var(--gray-100);
    }

    .truck-image-preview {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--gray-200);
