<!-- ============================================ -->
<!-- ADD / EDIT DRIVER MODAL -->
<!-- ============================================ -->
<div class="modal fade" id="driverModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="driverModalTitle">
                    <i class="bi bi-person-plus me-2"></i>New Driver
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="driverForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" id="form_driver_id">
                    <input type="hidden" id="form_driver_code">
                    <input type="hidden" id="form_existing_profile" value="">
                    <input type="hidden" id="form_existing_license" value="">

                    <!-- Profile Picture -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="d-flex align-items-center gap-4">
                                <div>
                                    <img id="profilePreview" src="http://localhost/larga-fms/public/assets/images/profile/user-1.jpg" class="profile-pic-preview" alt="Profile Preview">
                                </div>
                                <div>
                                    <label class="form-label">Profile Picture</label>
                                    <input type="file" id="form_profile_picture" class="form-control-file" accept=".jpg,.jpeg,.png,.gif" onchange="previewProfilePicture(this)">
                                    <small class="text-muted">Upload a photo (JPG, PNG, GIF). Leave blank to keep default.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Driver Code + Name -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Driver Code</label>
                            <input type="text" id="form_driver_code_display" class="form-control" readonly>
                        </div>
                        <div class="col-md-9">
                            <label class="form-label">Driver Name <span class="required">*</span></label>
                            <input type="text" id="form_driver_name" class="form-control" placeholder="Enter driver name" required>
                        </div>
                    </div>

                    <!-- Contact + Address -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Contact Number</label>
                            <input type="text" id="form_contact_number" class="form-control" placeholder="Phone number">
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Address</label>
                            <input type="text" id="form_address" class="form-control" placeholder="Address">
                        </div>
                    </div>

                    <!-- Employment Type + Date Hired + Status -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Employment Type</label>
                            <select id="form_employment_type" class="form-control">
                                <option value="">— Select —</option>
                                <option value="Regular">Regular</option>
                                <option value="Probationary">Probationary</option>
                                <option value="Contractual">Contractual</option>
                                <option value="Casual">Casual</option>
                                <option value="Freelance">Freelance</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Date Hired</label>
                            <input type="date" id="form_date_hired" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Driver Status</label>
                            <select id="form_driver_status" class="form-control">
                                <option value="AVAILABLE">Available</option>
                                <option value="ASSIGNED">Assigned</option>
                                <option value="ON_TRIP">On Trip</option>
                                <option value="RETURNING">Returning</option>
                                <option value="ON_LEAVE">On Leave</option>
                                <option value="SUSPENDED">Suspended</option>
                                <option value="INACTIVE">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <!-- Emergency Contact -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Emergency Contact</label>
                            <input type="text" id="form_emergency_contact" class="form-control" placeholder="Emergency contact name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Emergency Contact Number</label>
                            <input type="text" id="form_emergency_contact_number" class="form-control" placeholder="Emergency phone number">
                        </div>
                    </div>

                    <!-- Qualifications & Experience -->
                    <div class="form-section">
                        <div class="form-section-title"><i class="bi bi-clipboard-data"></i> Qualifications & Experience</div>
                        
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">Years Experience</label>
                                <input type="number" id="form_years_experience" class="form-control" value="0" min="0">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Heavy Vehicle Experience</label>
                                <input type="number" id="form_heavy_vehicle_experience" class="form-control" value="0" min="0">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tractor Head Experience</label>
                                <input type="number" id="form_tractor_head_experience" class="form-control" value="0" min="0">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">10-Wheeler Experience</label>
                                <input type="number" id="form_ten_wheeler_experience" class="form-control" value="0" min="0">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Long Distance Experience</label>
                                <select id="form_long_distance_experience" class="form-control">
                                    <option value="0">No</option>
                                    <option value="1">Yes</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">City / Urban Experience</label>
                                <select id="form_city_urban_experience" class="form-control">
                                    <option value="0">No</option>
                                    <option value="1">Yes</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Highway Experience</label>
                                <select id="form_highway_experience" class="form-control">
                                    <option value="0">No</option>
                                    <option value="1">Yes</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Route Experience</label>
                                <input type="text" id="form_route_experience" class="form-control" placeholder="e.g., Luzon Routes">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cargo Handling Experience</label>
                                <input type="text" id="form_cargo_handling_experience" class="form-control" placeholder="e.g., Containerized, General Cargo">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Defensive Driving Training</label>
                                <select id="form_defensive_driving_training" class="form-control">
                                    <option value="0">No</option>
                                    <option value="1">Yes</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Safety Training</label>
                                <select id="form_safety_training" class="form-control">
                                    <option value="0">No</option>
                                    <option value="1">Yes</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Training Expiration Date</label>
                                <input type="date" id="form_training_expiration_date" class="form-control">
                            </div>
                        </div>

                        <div class="row mb-0">
                            <div class="col-md-12">
                                <label class="form-label">Other Certifications</label>
                                <textarea id="form_other_certifications" class="form-control" rows="2" placeholder="Other certifications"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Driver Rating -->
                    <div class="form-section">
                        <div class="form-section-title"><i class="bi bi-star"></i> Driver Rating</div>
                        
                        <div class="row mb-0">
                            <div class="col-md-3">
                                <label class="form-label">Overall Rating</label>
                                <input type="number" id="form_overall_rating" class="form-control" value="0" step="0.1" min="0" max="5">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Rating Date</label>
                                <input type="date" id="form_rating_date" class="form-control">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Evaluated By</label>
                                <input type="text" id="form_evaluated_by" class="form-control" placeholder="Evaluator name">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Previous Rating</label>
                                <input type="number" id="form_previous_rating" class="form-control" value="0" step="0.1" min="0" max="5" readonly>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-12">
                                <label class="form-label">Evaluation Remarks</label>
                                <textarea id="form_evaluation_remarks" class="form-control" rows="2" placeholder="Evaluation remarks"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Driver\'s License Section -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-credit-card"></i> Driver\'s License
                            <span class="badge badge-secondary" style="font-size:8px;">Optional</span>
                        </div>
                        <p class="text-muted" style="font-size:12px;">Fill out if the driver has a valid license.</p>
                        
                        <div class="row mb-3">
                            <div class="col-md-3">
