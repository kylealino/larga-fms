        .stat-left .stat-value {
            font-size: 20px;
        }
        .toolbar {
            flex-direction: column;
            align-items: stretch;
        }
        .toolbar-left, .toolbar-right {
            flex-wrap: wrap;
        }
        .dataTables_filter input {
            width: 150px;
        }
    }

    @media (max-width: 480px) {
        .stat-grid {
            grid-template-columns: 1fr;
        }
        .lrg-module-header {
            padding: 12px 16px;
        }
        .lrg-module-header .header-left .module-info h4 {
            font-size: 14px;
        }
        .lrg-module-header .header-left .module-info h4 .module-badge {
            font-size: 8px;
            padding: 1px 8px;
        }
        .stat-card {
            padding: 12px 14px;
        }
        .stat-left .stat-value {
            font-size: 18px;
        }
        .stat-right {
            font-size: 24px;
        }
        .btn-icon {
            width: 28px;
            height: 28px;
            font-size: 13px;
        }
        .modal-body {
            padding: 16px;
        }
    }
</style>

