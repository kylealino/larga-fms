        left: 15px;
        top: 8px;
        bottom: 8px;
        width: 2px;
        background: var(--gray-200);
    }
    .journey-item {
        position: relative;
        padding: 12px 16px;
        background: #ffffff;
        border: 1px solid var(--gray-200);
        border-radius: 10px;
        margin-bottom: 12px;
        box-shadow: var(--shadow);
    }
    .journey-item::before {
        content: \'\';
        position: absolute;
        left: -32px;
        top: 20px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid var(--primary);
