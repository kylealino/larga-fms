    .stock-bar {
        height: 6px; background: var(--gray-200); border-radius: 3px;
        overflow: hidden; margin-top: 4px; width: 100%; max-width: 120px;
    }
    .stock-bar-inner {
        height: 100%;
        background: var(--success);
        border-radius: 3px;
        transition: width 0.3s ease;
